# Copy to .env (compose) or backend/.env (local dev) and adjust as needed.

# --- Backend / API ---
APP_NAME=Pulse AI API
APP_VERSION=0.2.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database ---
# Docker Compose default (matches docker-compose.yml service "db"):
DATABASE_URL=postgresql+psycopg2://pulse:pulse@db:5432/pulse
# Local dev against a local Postgres:
# DATABASE_URL=postgresql+psycopg2://pulse:pulse@localhost:5432/pulse
# Lightweight local fallback (SQLite, useful for quick experimentation):
# DATABASE_URL=sqlite:///./pulse.db

# --- Anomaly detection tuning ---
ANOMALY_THRESHOLD=0.75
ALERT_COOLDOWN_SECONDS=300
DEFAULT_REPLAY_COUNT=120
REPLAY_SPIKE_MULTIPLIER=4.5

# --- Runtime ---
CACHE_TTL_SECONDS=30
BACKGROUND_JOB_INTERVAL_SECONDS=60
RATE_LIMIT_PER_MINUTE=240

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
